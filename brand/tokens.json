{
  "$description": "rtok brand (Bitset B / Hex Diff): brand constants, the semantic colour roles per theme, elevation and glass alpha. Extends @pyrlyn/brand base/tokens.json (type, space, motion … live there; pinned in package.json). DTCG format; `node build.mjs` writes dist/tokens.css (--pyr-* roles) and the flat dist/legacy/tokens.css (--rtok-*, identical to web/src/styles/tokens.css). Every group names the real code it was taken from (snapshots in pyrlyn/brand v0.3.0 brands/rtok/sources/), see PROVENANCE.md 'Conflicts'.",
  "$extends": "@pyrlyn/brand/base/tokens.json",
  "$extensions": {
    "com.pyrlyn.brand": "rtok",
    "com.pyrlyn.defaultTheme": "dark",
    "com.pyrlyn.legacyFlat": true
  },
  "brand": {
    "$description": "Brand-constant fills, identical in dark and light. Sources: site/assets/css/custom.css:6-9 (deployed rtok site); web/src/input.css:18-21 (web admin, design/web-admin); listepo/landing src/lib/site.ts:56 (rtok page); rtok-brand-v3-B-tokens/DESIGN.md colors.",
    "cyan": {
      "$type": "color",
      "$value": "#5CE1FF",
      "$description": "Primary accent (blueprint cyan). Fills, marks, active state."
    },
    "coral": {
      "$type": "color",
      "$value": "#FF6B4A",
      "$description": "Delta / measured cut / danger. Keep scarce."
    },
    "navy": {
      "$type": "color",
      "$value": "#06101A",
      "$description": "Dark canvas; the mark tile; text on cyan."
    },
    "ink": {
      "$type": "color",
      "$value": "#0B1A24",
      "$description": "Light-theme ink; mark tile in light theme."
    },
    "green": {
      "$type": "color",
      "$value": "#3DDC97",
      "$description": "Success fill."
    },
    "amber": {
      "$type": "color",
      "$value": "#F5C451",
      "$description": "Warning fill (web admin only so far)."
    }
  },
  "theme": {
    "$description": "Semantic colors per theme. Dark is the default. Sources: web/src/input.css:15-34 (web admin, design/web-admin), site/assets/css/custom.css:6-9 (deployed rtok site), rtok-brand-v3-B-tokens/DESIGN.md + webui-mock/themes/TOKENS.md. *-fg are text-safe variants (>= 4.5:1 on bg, surface and surface-2).",
    "dark": {
      "bg": {
        "$type": "color",
        "$value": "{brand.navy}",
        "$description": "canvas"
      },
      "surface": {
        "$type": "color",
        "$value": "#0A1622",
        "$description": "cards / panels"
      },
      "surface-2": {
        "$type": "color",
        "$value": "#0F1E2E",
        "$description": "raised / hover"
      },
      "surface-3": {
        "$type": "color",
        "$value": "#15283C",
        "$description": "pressed / skeleton / switch track"
      },
      "border": {
        "$type": "color",
        "$value": "#1A3348",
        "$description": "hairline"
      },
      "border-strong": {
        "$type": "color",
        "$value": "#2A4A66",
        "$description": "hover border"
      },
      "fg": {
        "$type": "color",
        "$value": "#E8F7FF",
        "$description": "ink"
      },
      "fg-muted": {
        "$type": "color",
        "$value": "#8AA8BC"
      },
      "fg-subtle": {
        "$type": "color",
        "$value": "#7F9AAE",
        "$description": "AA-raised (v3 pack had #5A7388 = 3.87:1)"
      },
      "accent": {
        "$type": "color",
        "$value": "{brand.cyan}"
      },
      "accent-fg": {
        "$type": "color",
        "$value": "{brand.cyan}",
        "$description": "accent used as text"
      },
      "accent-muted": {
        "$type": "color",
        "$value": "#5CE1FF26",
        "$description": "selected nav / pressed chip background: accent at 15% (web/src/input.css:69,82)"
      },
      "on-accent": {
        "$type": "color",
        "$value": "{brand.navy}"
      },
      "delta": {
        "$type": "color",
        "$value": "{brand.coral}"
      },
      "delta-fg": {
        "$type": "color",
        "$value": "{brand.coral}"
      },
      "danger": {
        "$type": "color",
        "$value": "{brand.coral}"
      },
      "danger-fg": {
        "$type": "color",
        "$value": "{brand.coral}"
      },
      "success": {
        "$type": "color",
        "$value": "{brand.green}"
      },
      "success-fg": {
        "$type": "color",
        "$value": "{brand.green}"
      },
      "warn": {
        "$type": "color",
        "$value": "{brand.amber}"
      },
      "warn-fg": {
        "$type": "color",
        "$value": "{brand.amber}"
      },
      "focus": {
        "$type": "color",
        "$value": "{brand.cyan}",
        "$description": "focus ring outer stroke"
      },
      "mark-tile": {
        "$type": "color",
        "$value": "{brand.navy}",
        "$description": "the bitset mark always sits on a dark tile"
      },
      "shine": {
        "$type": "color",
        "$value": "#E8F7FF",
        "$description": "inset top highlight in elevation"
      },
      "selection": {
        "$type": "color",
        "$value": "#5CE1FF4D",
        "$description": "::selection, accent at 30%"
      }
    },
    "light": {
      "bg": {
        "$type": "color",
        "$value": "#F4F8FB"
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "surface-2": {
        "$type": "color",
        "$value": "#E8EEF4"
      },
      "surface-3": {
        "$type": "color",
        "$value": "#DCE5EE"
      },
      "border": {
        "$type": "color",
        "$value": "#C5D3E0"
      },
      "border-strong": {
        "$type": "color",
        "$value": "#9BB0C4"
      },
      "fg": {
        "$type": "color",
        "$value": "{brand.ink}"
      },
      "fg-muted": {
        "$type": "color",
        "$value": "#4F6679",
        "$description": "AA on surface-2 (v3 pack had #5A7388 = 4.24:1 there)"
      },
      "fg-subtle": {
        "$type": "color",
        "$value": "#5A7388"
      },
      "accent": {
        "$type": "color",
        "$value": "{brand.cyan}",
        "$description": "fill only; never text on light"
      },
      "accent-fg": {
        "$type": "color",
        "$value": "#006F8C",
        "$description": "accent used as text on light (5.38:1 on bg)"
      },
      "accent-muted": {
        "$type": "color",
        "$value": "#5CE1FF26",
        "$description": "selected nav / pressed chip background: accent at 15% (web/src/input.css:69,82)"
      },
      "on-accent": {
        "$type": "color",
        "$value": "{brand.navy}"
      },
      "delta": {
        "$type": "color",
        "$value": "{brand.coral}",
        "$description": "fill / outline only on light"
      },
      "delta-fg": {
        "$type": "color",
        "$value": "#B8361C"
      },
      "danger": {
        "$type": "color",
        "$value": "{brand.coral}"
      },
      "danger-fg": {
        "$type": "color",
        "$value": "#B8361C"
      },
      "success": {
        "$type": "color",
        "$value": "{brand.green}"
      },
      "success-fg": {
        "$type": "color",
        "$value": "#0B7A50"
      },
      "warn": {
        "$type": "color",
        "$value": "{brand.amber}"
      },
      "warn-fg": {
        "$type": "color",
        "$value": "#8A5A00"
      },
      "focus": {
        "$type": "color",
        "$value": "#006F8C",
        "$description": "cyan is 1.6:1 on light bg; the ring uses accent-fg in light"
      },
      "mark-tile": {
        "$type": "color",
        "$value": "{brand.ink}",
        "$description": "v3 webui-mock/themes/TOKENS.md: the bitset always sits on a dark tile"
      },
      "shine": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "selection": {
        "$type": "color",
        "$value": "#5CE1FF4D"
      }
    }
  },
  "shadow": {
    "$description": "Elevation, web/tailwind.config.js:46-49. The inset line uses the theme's shine color; see dist/tokens.css.",
    "e1": {
      "$type": "shadow",
      "$value": [
        {
          "inset": true,
          "color": "{theme.dark.shine}",
          "alpha": 0.06,
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "0",
          "spread": "0"
        },
        {
          "color": "#000000",
          "alpha": 0.2,
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0"
        }
      ]
    },
    "e2": {
      "$type": "shadow",
      "$value": [
        {
          "inset": true,
          "color": "{theme.dark.shine}",
          "alpha": 0.07,
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "0",
          "spread": "0"
        },
        {
          "color": "#000000",
          "alpha": 0.28,
          "offsetX": "0",
          "offsetY": "4px",
          "blur": "12px",
          "spread": "-2px"
        },
        {
          "color": "#000000",
          "alpha": 0.2,
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "0"
        }
      ]
    },
    "e3": {
      "$type": "shadow",
      "$value": [
        {
          "inset": true,
          "color": "{theme.dark.shine}",
          "alpha": 0.08,
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "0",
          "spread": "0"
        },
        {
          "color": "#000000",
          "alpha": 0.45,
          "offsetX": "0",
          "offsetY": "16px",
          "blur": "40px",
          "spread": "-8px"
        },
        {
          "color": "#000000",
          "alpha": 0.25,
          "offsetX": "0",
          "offsetY": "4px",
          "blur": "12px",
          "spread": "0"
        }
      ]
    }
  },
  "effect": {
    "$description": "Glass alpha per theme (role glass-alpha), web/src/input.css:22,34.",
    "glass-alpha-dark": {
      "$type": "number",
      "$value": 0.82
    },
    "glass-alpha-light": {
      "$type": "number",
      "$value": 0.86
    }
  }
}
