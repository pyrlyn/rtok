{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Export",
  "type": "object",
  "properties": {
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Edge"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Link"
      }
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "nodes": {
      "description": "Empty at the `overview` level.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Proj"
      }
    },
    "schema": {
      "type": "string",
      "const": "rtok.graph.v1"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "projects",
    "links",
    "nodes",
    "edges",
    "meta"
  ],
  "$defs": {
    "Edge": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind"
      ]
    },
    "Link": {
      "type": "object",
      "properties": {
        "from": {
          "type": "integer",
          "format": "int32"
        },
        "kind": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "references": {
          "description": "Call references from `from` into `to` found in the indexes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "to": {
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind",
        "references"
      ]
    },
    "Meta": {
      "type": "object",
      "properties": {
        "depth": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "exported_at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "focus": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "description": "`overview`, `symbols` or `focus`.",
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "partial": {
          "description": "A project was still indexing, not indexed, or could not answer.",
          "type": "boolean"
        },
        "redacted": {
          "type": "boolean"
        },
        "rtok_version": {
          "type": "string"
        },
        "scope": {
          "description": "Project names of the scope.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "level",
        "exported_at",
        "rtok_version",
        "redacted",
        "partial",
        "notes"
      ]
    },
    "Node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "format": "int32"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "description": "Relative to the project root.",
          "type": "string"
        },
        "project": {
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "project",
        "kind",
        "name",
        "path",
        "line"
      ]
    },
    "Proj": {
      "type": "object",
      "properties": {
        "backend": {
          "description": "`tags`, `lsp` or `text`: the mode that answers for the project.",
          "type": "string"
        },
        "health": {
          "description": "`ok`, `stale`, `not indexed`, `missing` or `unknown`.",
          "type": "string"
        },
        "id": {
          "description": "0 for a directory that is not in the registry.",
          "type": "integer",
          "format": "int32"
        },
        "indexed_at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "name": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "root": {
          "description": "`~/...` under the home directory, `.../name` elsewhere, unless redaction is off.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "root",
        "origin",
        "backend",
        "health"
      ]
    }
  }
}
