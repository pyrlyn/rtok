-- Compilation schema for the tables used by NoteFilesQueries.
-- Runtime schema ownership stays with migrations/ and Store.open; never call
-- NoteFilesDatabase.Schema.create/migrate on a store. NoteFilesSchemaTest checks
-- these column declarations against the migrated database.
CREATE TABLE notes (
    id INTEGER PRIMARY KEY,
    ts INTEGER NOT NULL DEFAULT (unixepoch()),
    project TEXT,
    kind TEXT NOT NULL,
    title TEXT NOT NULL,
    body TEXT NOT NULL,
    retired INTEGER,
    superseded_by INTEGER,
    pinned INTEGER NOT NULL DEFAULT 0,
    uses INTEGER NOT NULL DEFAULT 0,
    last_used INTEGER
);

CREATE TABLE note_files (
    note_id INTEGER NOT NULL REFERENCES notes(id) ON DELETE CASCADE,
    path TEXT NOT NULL,
    PRIMARY KEY (note_id, path)
);

CREATE TABLE read_cache (
    session TEXT NOT NULL,
    path TEXT NOT NULL,
    sha256 TEXT NOT NULL,
    ts INTEGER NOT NULL DEFAULT (unixepoch()),
    archive_id TEXT,
    PRIMARY KEY (session, path)
);
