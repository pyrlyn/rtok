{{/*
  Reference pages come straight from the repository markdown mounted at assets/repo.
  The repo files carry no front matter, so title, weight and the edit link live here.
*/}}
{{ $pages := slice
  (dict "path" "architecture"     "title" "Architecture"     "file" "repo/architecture.md"           "edit" "architecture.md")
  (dict "path" "agency"           "title" "Agency"           "file" "repo/docs/agency.md"            "edit" "docs/agency.md")
  (dict "path" "agents"           "title" "Agents"           "file" "repo/docs/agents.md"            "edit" "docs/agents.md")
  (dict "path" "agents-and-worktrees" "title" "Agents and worktrees" "file" "repo/docs/agents-and-worktrees.md" "edit" "docs/agents-and-worktrees.md")
  (dict "path" "comparison"       "title" "Comparison"       "file" "repo/docs/comparison.md"        "edit" "docs/comparison.md")
  (dict "path" "configuration"    "title" "Configuration"    "file" "repo/docs/config.md"            "edit" "docs/config.md")
  (dict "path" "cmd-rules"        "title" "Command filter rules" "file" "repo/docs/cmd-rules.md"         "edit" "docs/cmd-rules.md")
  (dict "path" "colima"           "title" "Colima"           "file" "repo/docs/colima.md"           "edit" "docs/colima.md")
  (dict "path" "lsp"              "title" "LSP backend"      "file" "repo/docs/lsp.md"               "edit" "docs/lsp.md")
  (dict "path" "otel"             "title" "OpenTelemetry"    "file" "repo/docs/otel.md"              "edit" "docs/otel.md")
  (dict "path" "plugin-authoring" "title" "Plugin authoring" "file" "repo/docs/plugin-authoring.md"  "edit" "docs/plugin-authoring.md")
  (dict "path" "plugin-versions"  "title" "Plugin versions"  "file" "repo/docs/plugin-versions.md"   "edit" "docs/plugin-versions.md")
  (dict "path" "prompt-cache"     "title" "Prompt cache"     "file" "repo/docs/prompt-cache.md"      "edit" "docs/prompt-cache.md")
  (dict "path" "batch-flex"       "title" "Batch, Flex, and routing" "file" "repo/docs/batch-flex.md" "edit" "docs/batch-flex.md")
  (dict "path" "llm-soft-compression" "title" "LLM soft compression" "file" "repo/docs/llm-soft-compression.md" "edit" "docs/llm-soft-compression.md")
  (dict "path" "model-routing"    "title" "Model routing"    "file" "repo/docs/model-routing.md"     "edit" "docs/model-routing.md")
  (dict "path" "report"           "title" "Report"           "file" "repo/docs/report.md"             "edit" "docs/report.md")
  (dict "path" "release"          "title" "Release process"  "file" "repo/docs/release.md"           "edit" "docs/release.md")
  (dict "path" "windows"          "title" "Developing on Windows" "file" "repo/docs/windows.md"      "edit" "docs/windows.md")
  (dict "path" "roadmap"          "title" "Roadmap"          "file" "repo/roadmap.md"                "edit" "roadmap.md")
  (dict "path" "changelog"        "title" "Changelog"        "file" "repo/CHANGELOG.md"              "edit" "CHANGELOG.md")
}}

{{/*
  Exempt from this list: docs/plugin-plan-template.md (scaffold copied into
  src/plugins/<id>/PLAN.md — see docs/plugin-authoring.md) and docs/sonarcloud-setup.md
  (maintainer CI setup, not end-user reference). Same reasoning keeps CONTRIBUTING.md
  off the site.
*/}}

{{ range $i, $p := $pages }}
  {{ $r := resources.Get $p.file }}
  {{ with $r }}
    {{/* Hextra renders the page title as the h1, so drop the leading h1 in the source file. */}}
    {{ $body := replaceRE `\A#\s+[^\n]*\n` "" .Content }}
    {{ $.AddPage (dict
      "path" $p.path
      "title" $p.title
      "weight" (add $i 1)
      "params" (dict "editURL" (printf "https://github.com/pyrlyn/rtok/edit/main/%s" $p.edit))
      "content" (dict "value" $body "mediaType" "text/markdown")
    ) }}
  {{ else }}
    {{ errorf "reference adapter: %q not found under assets" $p.file }}
  {{ end }}
{{ end }}
