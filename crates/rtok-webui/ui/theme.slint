// Dual theme — Bitset B. Default dark. Toggle: RtokTheme.dark = false;
// Breakpoints (layout only): sm <640 | md 640–1023 | lg 1024–1439 | xl 1440–1919 | 2xl ≥1920
export global RtokTheme {
    in-out property <bool> dark: true;

    in-out property <color> accent: #5CE1FF;
    in-out property <color> delta: #FF6B4A;
    in-out property <color> success: dark ? #3DDC97 : #0F8F5F;

    in-out property <color> canvas: dark ? #06101A : #F4F8FB;
    in-out property <color> surface-1: dark ? #0A1622 : #FFFFFF;
    in-out property <color> surface-2: dark ? #0F1E2E : #E8EEF4;
    in-out property <color> hairline: dark ? #1A3348 : #C5D3E0;
    in-out property <color> hairline-strong: dark ? #2A4A66 : #9BB0C4;
    in-out property <color> ink: dark ? #E8F7FF : #0B1A24;
    in-out property <color> ink-muted: dark ? #8AA8BC : #5A7388;
    in-out property <color> ink-subtle: dark ? #5A7388 : #7A92A6;
    in-out property <color> accent-muted: dark ? #5CE1FF33 : #5CE1FF29;
    in-out property <color> on-accent: #06101A;
    in-out property <color> mark-tile: dark ? #06101A : #0B1A24;

    in-out property <length> radius-sm: 4px;
    in-out property <length> radius-md: 6px;
    in-out property <length> radius-lg: 10px;
    in-out property <length> space-1: 4px;
    in-out property <length> space-2: 8px;
    in-out property <length> space-3: 12px;
    in-out property <length> space-4: 16px;
    in-out property <length> space-5: 24px;

    // Type scale (MainWindow grows both on ultrawide).
    in-out property <length> title-size: 22px;
    in-out property <length> body-size: 13px;

    // Shared breakpoint vocabulary (sm/md/lg/xl, see RESPONSIVE.md)
    in-out property <length> bp-sm: 640px;
    in-out property <length> bp-md: 1024px;
    in-out property <length> bp-lg: 1440px;
    in-out property <length> bp-xl: 1920px;

    in-out property <length> sidebar-w-full: 200px;
    in-out property <length> sidebar-w-rail: 56px;
    // Legacy alias — full labeled sidebar
    in-out property <length> sidebar-w: 200px;

    // Optional density scale: denser on mobile, roomier on 2xl (applied in MainWindow)
    in-out property <float> density-compact: 0.85;
    in-out property <float> density-roomy: 1.15;
}
